        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.EasyReminder</item>
    </style>

    <style name="Theme.EasyReminder" parent="Base.Theme.EasyReminder" />
</resources>